{
    "id": "org.kde.kodaskanna",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "kodaskanna",
    "rename-icon": "kodaskanna",
    "rename-appdata-file": "org.kde.kodaskanna.appdata.xml",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--filesystem=xdg-pictures:ro"
    ],
    "cleanup": [
        "/include",
        "/lib/cmake",
        "/lib/pkgconfig",
        "/share/qlogging-categories6",
        "*.a"
    ],
    "modules": [
        {
            "name": "zxing",
            "config-opts": [
                "-DBUILD_DEPENDENCIES=LOCAL",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DBUILD_EXAMPLES=OFF"
            ],
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/zxing-cpp/zxing-cpp/archive/v3.1.1.tar.gz",
                    "sha256": "7286b1e6ade66fe82b7c8208b4595deeb55d6486b410834fdc65702f46650542",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 101246,
                        "stable-only": true,
                        "url-template": "https://github.com/zxing-cpp/zxing-cpp/archive/v$version.tar.gz"
                    }
                }
            ]
        },
        {
            "name": "kodaskanna",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_TESTING=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/unstable/kodaskanna/0.2.3/src/kodaskanna-0.2.3.tar.xz",
                    "sha256": "fcc67d03d233ef987d966907746f04641083a87d42d6ce78d06af95ccd8903cd",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 375753,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/unstable/kodaskanna/$version/src/kodaskanna-$version.tar.xz"
                    }
                }
            ]
        }
    ]
}
